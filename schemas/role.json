{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sendesis.dev/schemas/role.json",
  "title": "Role contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "purpose", "prompt_file", "inputs", "definition_of_done", "output_schema", "tools", "failover_order"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"enum": ["worker", "reviewer"]},
    "purpose": {"type": "string", "minLength": 10},
    "prompt_file": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "description"],
        "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "required": {"type": "boolean"}}
      }
    },
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_schema": {"type": "string", "minLength": 1},
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "network"],
      "properties": {
        "allowed": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "search", "edit", "shell"]}},
        "network": {"const": false, "description": "Always false; a workflow stage may grant loopback."}
      }
    },
    "context": {"type": "array", "uniqueItems": true, "items": {"enum": ["governing_docs", "retractions", "decisions"]}},
    "model_requirements": {
      "type": "object", "additionalProperties": false,
      "properties": {"min_context_tokens": {"type": "integer", "minimum": 1}, "structured_output": {"type": "boolean"}}
    },
    "qualification": {
      "type": "object", "additionalProperties": false, "required": ["suite", "min_cases", "expiry_days", "metrics"],
      "properties": {
        "suite": {"type": "string", "minLength": 1},
        "min_cases": {"type": "integer", "minimum": 1},
        "expiry_days": {"type": "integer", "minimum": 1},
        "metrics": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "direction", "threshold"],
            "properties": {
              "name": {"type": "string"},
              "direction": {"enum": ["higher_is_better", "lower_is_better"]},
              "threshold": {"type": "number"},
              "basis": {"enum": ["interval", "point"], "default": "interval"}
            }
          }
        }
      }
    },
    "failover_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "per_call_timeout_s": {"type": "integer", "minimum": 1},
        "max_turns": {"type": "integer", "minimum": 1},
        "escalation_reserve_calls": {"type": "integer", "minimum": 0}
      }
    }
  }
}
