{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sendesis.dev/schemas/receipt.json",
  "title": "Qualification receipt",
  "description": "Evidence that a profile met a role's bar on a suite. Valid only while role version, profile hash, suite hash, CLI version and model all still match, and before expires_at. Otherwise the router treats the status as UNKNOWN.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "role", "profile", "observed", "suite", "status", "scores", "cost", "issued_at", "expires_at"],
  "properties": {
    "kind": {"enum": ["single", "team_gate"], "description": "single qualifies one profile; team_gate records a gate result for loop mode."},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "prompt_sha256"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Canonical hash of the role file, so an edit without a version bump still voids the receipt."},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "sha256"],
      "properties": {
        "ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "One id for single; all participating ids for team_gate."},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Hash of the canonicalized profile file(s)."}
      }
    },
    "observed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "model", "runner_config_sha256"],
        "properties": {
          "profile_id": {"type": "string"},
          "runner_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Hash of the runner's fixed flags and environment policy. Isolation flags change token overhead, so a change voids the receipt."},
          "cli_version": {"type": "string"},
          "model": {"type": "string", "description": "Model actually reported by the runner, not the requested one."},
          "workdir_context_sha256": {"type": "string", "description": "Hash of AGENTS.md / CLAUDE.md in the suite working directory."}
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "n_cases"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "n_cases": {"type": "integer", "minimum": 1}
      }
    },
    "status": {"enum": ["QUALIFIED", "FAILED", "UNKNOWN"]},
    "status_reason": {"type": "string"},
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "ci_low", "ci_high", "threshold", "pass"],
        "properties": {
          "metric": {"type": "string"},
          "arm": {"type": "string", "description": "team_gate only: cross_model_loop, same_model_loop, single_pass, n_sample_vote."},
          "rounds": {"type": "integer", "minimum": 1},
          "value": {"type": "number"},
          "ci_low": {"type": "number"},
          "ci_high": {"type": "number"},
          "ci_method": {"type": "string", "default": "wilson"},
          "threshold": {"type": "number"},
          "pass": {"type": "boolean"}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "wall_s"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "wall_s": {"type": "number", "minimum": 0},
        "list_usd": {"type": "number", "minimum": 0, "description": "Notional list price where the runner reports it. Not a charge on flat-rate plans."}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
