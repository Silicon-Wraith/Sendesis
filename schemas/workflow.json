{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sendesis.dev/schemas/workflow.json",
  "title": "Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "stages"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 5},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}}
  },
  "$defs": {
    "seat": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "properties": {
        "role": {"type": "string"},
        "count": {"type": "integer", "minimum": 1, "default": 1},
        "distinct_families": {"type": "integer", "minimum": 1, "default": 1},
        "blind": {"type": "boolean", "default": false}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "seats": {"type": "array", "items": {"$ref": "#/$defs/seat"}},
        "inner_loop": {
          "type": "object", "additionalProperties": false, "required": ["checker", "max_fix_rounds"],
          "properties": {"checker": {"type": "string"}, "max_fix_rounds": {"type": "integer", "minimum": 1}, "tests": {"type": "boolean"}}
        },
        "loops": {
          "type": "object", "additionalProperties": false, "required": ["max_rounds", "stop_rule"],
          "properties": {"max_rounds": {"type": "integer", "minimum": 1}, "stop_rule": {"enum": ["no_new_confirmed_finding"]}}
        },
        "gate": {
          "type": "object", "additionalProperties": false, "required": ["on"],
          "properties": {
            "on": {"type": "boolean"},
            "answers": {"type": "array", "uniqueItems": true, "items": {"enum": ["approve", "reject", "edit", "send_back", "skip"]}}
          }
        },
        "evidence": {"type": "array", "uniqueItems": true, "items": {"enum": ["diff", "files_in_scope", "tests", "governing_docs", "retractions", "decisions", "symbols", "freshness"]}},
        "network": {"enum": ["none", "loopback"], "default": "none"},
        "writes": {"type": "array", "uniqueItems": true, "items": {"enum": ["decisions", "resolved_conflicts", "dissent"]}},
        "budgets": {
          "type": "object", "additionalProperties": false,
          "properties": {"max_total_tokens": {"type": "integer", "minimum": 1}, "max_wall_s": {"type": "integer", "minimum": 1}}
        },
        "skippable": {"type": "boolean", "default": true}
      }
    }
  }
}
