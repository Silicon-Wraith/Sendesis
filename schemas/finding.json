{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sendesis.dev/schemas/finding.json",
  "title": "Reviewer output v2",
  "description": "What every reviewer role returns. Fields marked 'set by code' are filled by adjudication, never by the reviewer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role_id", "findings", "checks"],
  "properties": {
    "run_id": {"type": "string"},
    "role_id": {"type": "string"},
    "round": {"type": "integer", "minimum": 0},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "dissent": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "summary": {"type": "string"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "category", "severity", "location", "evidence", "claim_status"],
      "properties": {
        "id": {"type": "string"},
        "claim": {"type": "string", "minLength": 5},
        "category": {"type": "string", "minLength": 1, "description": "From the role's category list; a CWE id such as CWE-89 for security."},
        "severity": {"enum": ["blocking", "refine", "note"]},
        "impact": {"enum": ["critical", "high", "medium", "low", "info"]},
        "resolution": {"enum": ["change_code", "change_design", "clarify"]},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {"type": "string"},
            "line_start": {"type": "integer", "minimum": 1},
            "line_end": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "claim_status": {"enum": ["proven", "hypothesis"]},
        "suggested_fix": {"type": "string"},
        "evidence_valid": {"type": "boolean", "description": "Set by code."},
        "state": {"enum": ["confirmed", "disputed"], "description": "Set by code."},
        "raised_by": {"type": "string", "description": "Set by code: blinded label A, B, ..."},
        "supporters": {"type": "array", "items": {"type": "string"}, "description": "Set by code."},
        "first_round": {"type": "integer", "minimum": 0, "description": "Set by code."}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["code_quote", "doc_quote", "test_result", "query"]},
        "file": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "path": {"type": "string"},
        "section": {"type": "string"},
        "text": {"type": "string"},
        "test_id": {"type": "string"},
        "query": {"type": "string"},
        "expected": {"type": "string"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome"],
      "properties": {
        "id": {"type": "string"},
        "outcome": {"enum": ["findings", "no_findings", "could_not_run"]},
        "note": {"type": "string"}
      }
    }
  }
}
