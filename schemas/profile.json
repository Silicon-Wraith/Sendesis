{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sendesis.dev/schemas/profile.json",
  "title": "Execution profile v2",
  "description": "How a model is reached. Sandbox and tools come from the role and the stage, never from the profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "enabled", "family", "model", "timeout_s"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "enabled": {"type": "boolean"},
    "family": {"type": "string", "minLength": 1, "description": "Model family for diversity rules, e.g. anthropic, openai, qwen."},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id"],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^(claude_code|codex|openai_like|agno:[a-z_][a-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*)$",
          "description": "claude_code and codex use agno-cli-models; openai_like uses Agno's OpenAILike; agno:<module>:<Class> is any Agno model class under agno.models.<module>."
        },
        "id": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "pattern": "^https?://"},
        "api_key_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "cli_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"}
      }
    },
    "timeout_s": {"type": "integer", "minimum": 1},
    "max_turns": {"type": "integer", "minimum": 1},
    "notes": {"type": "string"}
  }
}
